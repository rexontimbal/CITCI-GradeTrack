# Copy this file to .env and fill in real values. Never commit .env.
# This is the DEVELOPMENT template — see deploy/.env.prod.example for the
# production one (more required variables; see docs/DEPLOYMENT.md).
#
# Note: DJANGO_SETTINGS_MODULE is NOT read from this file — it has to be
# known before Django loads a settings module to read .env in the first
# place. It defaults to config.settings.dev (manage.py) / config.settings.prod
# (wsgi.py/asgi.py); override by setting the real environment variable.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://citci_user:citci_pass@127.0.0.1:5432/citci_gradetrack

# Where backup_db writes pg_dump files + a media/ copy (see
# core/management/commands/backup_db.py). Defaults to ./backups if unset.
# BACKUP_DIR=
# BACKUP_KEEP=30

# django-debug-toolbar is opt-in (config/settings/dev.py) — its per-request
# panels add real overhead, which skews query-count/latency measurements
# (docs/PERFORMANCE.md) if left on by habit. Set to 1 only when you actually
# want the toolbar for a debugging session.
# DEBUG_TOOLBAR=1
