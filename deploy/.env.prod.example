# Production environment template — copy to .env on the server and fill in
# real values. Never commit the real .env. See docs/DEPLOYMENT.md.
#
# DJANGO_SETTINGS_MODULE is NOT set here — it must be a real process
# environment variable (systemd EnvironmentFile= line, or NSSM's service
# environment on Windows), set to config.settings.prod, since it has to be
# known before Django loads a settings module to read this file from.

SECRET_KEY=generate-a-real-one-see-below
DEBUG=False

# Comma-separated — the hostname(s)/IP(s) this server answers to.
ALLOWED_HOSTS=gradetrack.citci.local
# Needed because Django's CSRF check compares the request's Origin header
# against this list once DEBUG=False — include the scheme.
CSRF_TRUSTED_ORIGINS=http://gradetrack.citci.local

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://citci_user:citci_pass@127.0.0.1:5432/citci_gradetrack

# Off for a plain-HTTP LAN deployment (the default — CITCI may start this
# way with no certificate yet). Turn on once Nginx/IIS is terminating TLS
# with a real or self-signed/internal-CA certificate — see
# docs/DEPLOYMENT.md "HTTPS" section before flipping this, since turning it
# on without a TLS front end makes the site unreachable (redirect loop).
ENABLE_HTTPS=False

# Windows (Waitress) target only — turn on to have Django serve static/
# files itself via WhiteNoise, since there's no Nginx in front there. Leave
# off on the Ubuntu/Nginx target (Nginx serves static/ directly, faster).
USE_WHITENOISE=False

# Generate a real SECRET_KEY with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"

# Backups (core/management/commands/backup_db.py) — defaults to ./backups
# and keeping the last 30 if unset.
# BACKUP_DIR=/opt/citci-gradetrack/backups
# BACKUP_KEEP=30

# Rotating log files (config/settings/prod.py) — defaults to ./logs if unset.
# LOG_DIR=/opt/citci-gradetrack/logs

# Only needed if pg_dump/pg_restore/psql aren't on PATH for the service user.
# PG_DUMP_PATH=/usr/bin/pg_dump
# PG_RESTORE_PATH=/usr/bin/pg_restore
